<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cq_background"
    android:padding="24dp">

    <!-- Top Header with Step Counter & Skip -->
    <TextView
        android:id="@+id/tv_onboarding_step"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_purple"
        android:fontFamily="@font/jetbrains_mono"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:text="STEP 1 OF 3"
        android:textColor="@color/cq_on_primary_container"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btn_skip_onboarding"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btn_skip_onboarding" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_onboarding"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/btn_skip"
        android:textColor="@color/cq_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ViewPager2 for Onboarding Slides -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewpager_onboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layout_onboarding_indicators"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_skip_onboarding" />

    <!-- Page Indicator Dots -->
    <LinearLayout
        android:id="@+id/layout_onboarding_indicators"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/layout_onboarding_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:id="@+id/dot_1"
            android:layout_width="28dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_purple" />

        <View
            android:id="@+id/dot_2"
            android:layout_width="10dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_cyan" />

        <View
            android:id="@+id/dot_3"
            android:layout_width="10dp"
            android:layout_height="8dp"
            android:layout_marginHorizontal="4dp"
            android:background="@drawable/bg_pill_cyan" />
    </LinearLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:id="@+id/layout_onboarding_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_back"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginEnd="12dp"
            android:text="@string/btn_back"
            android:textColor="@color/cq_text_primary"
            android:visibility="invisible"
            app:cornerRadius="16dp"
            app:strokeColor="@color/cq_card_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_onboarding_next"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="@string/btn_next"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/cq_primary"
            app:cornerRadius="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
