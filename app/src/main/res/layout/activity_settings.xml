<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cq_background"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cq_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageButton
            android:id="@+id/btn_settings_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/cq_text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk"
                android:text="Preferences &amp; Settings"
                android:textColor="@color/cq_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrains_mono"
                android:text="Persisted Theme, Notifications &amp; Coding Lab Defaults"
                android:textColor="@color/cq_cyan_bright"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cq_card_stroke" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Theme Selection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/cq_card_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/cq_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="Theme Appearance"
                        android:textColor="@color/cq_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Choose Dark Mode, Light Mode, or System Default. Automatically persisted across app restarts."
                        android:textColor="@color/cq_text_secondary"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_settings_theme"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_settings_theme_dark"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/theme_dark"
                            android:textColor="@color/cq_text_primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_settings_theme_light"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/theme_light"
                            android:textColor="@color/cq_text_primary" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/rb_settings_theme_system"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/theme_system"
                            android:textColor="@color/cq_text_primary" />
                    </RadioGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Event Notification Toggles Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/cq_card_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/cq_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="Notification Preferences"
                        android:textColor="@color/cq_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Control in-app and future push alerts for achievements, streaks, and daily quests."
                        android:textColor="@color/cq_text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_achievements"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="Achievement &amp; Level-Up Alerts"
                        android:textColor="@color/cq_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_daily_goals"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Daily Goal Completion Alerts"
                        android:textColor="@color/cq_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_streak"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Streak Qualification &amp; Reminders"
                        android:textColor="@color/cq_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_daily_challenge"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Daily Challenge Alerts"
                        android:textColor="@color/cq_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_daily_reminder"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Daily Practice Reminder"
                        android:textColor="@color/cq_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Coding Workspace Preferences Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@color/cq_card_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/cq_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="Learning &amp; Coding Lab"
                        android:textColor="@color/cq_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_smart_hints"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:text="Enable Step-by-Step Smart Hints"
                        android:textColor="@color/cq_text_primary" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_pref_sound_effects"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Gamification Sound Effects"
                        android:textColor="@color/cq_text_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Supabase Cloud Database & Backend Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/cq_card_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/cq_cyan_bright"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/space_grotesk"
                            android:text="Supabase Cloud Database"
                            android:textColor="@color/cq_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_settings_supabase_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_cyan"
                            android:fontFamily="@font/jetbrains_mono"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:text="● CONNECTED"
                            android:textColor="@color/cq_cyan_bright"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_settings_supabase_endpoint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:text="Host: Not configured"
                        android:textColor="@color/cq_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_settings_supabase_description"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Cloud sync connects your local Room SQLite database with Supabase PostgreSQL for multi-device sync, auth, and global rankings."
                        android:textColor="@color/cq_text_secondary"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_settings_sync_supabase"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="Sync Cloud Now"
                            android:textColor="@color/cq_background"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/cq_cyan_bright"
                            app:cornerRadius="12dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_settings_supabase_guide"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginStart="6dp"
                            android:text="Setup Guide"
                            android:textColor="@color/cq_text_primary"
                            android:textSize="13sp"
                            app:cornerRadius="12dp"
                            app:strokeColor="@color/cq_card_stroke" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Account & Session Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="@color/cq_card_bg"
                app:cardCornerRadius="18dp"
                app:strokeColor="@color/cq_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk"
                        android:text="Account &amp; Session"
                        android:textColor="@color/cq_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_settings_account_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/cq_cyan_bright"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_logout"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Log Out"
                        android:textColor="@color/cq_text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/cq_card_stroke" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_settings_delete_account"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_delete_account"
                        android:textColor="@color/cq_error"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
